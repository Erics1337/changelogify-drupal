{#
/**
 * @file
 * Template for public changelog release listing.
 */
#}
<div class="changelogify-release-list" aria-live="polite">
  {% if releases is empty %}
    <p class="changelogify-release-list__empty">{{ 'No releases published yet.'|t }}</p>
  {% else %}
    {% for item in releases %}
      <article class="changelogify-release-teaser">
        <header>
          <h2>
            <a href="{{ item.url }}" rel="bookmark">
              {{ item.title }}
            </a>
          </h2>
          <time datetime="{{ item.date_iso }}">
            {{ item.date }}
          </time>
          {% if item.version %}
            <span class="version">{{ 'Version @version'|t({'@version': item.version}) }}</span>
          {% endif %}
        </header>
        {% if item.excerpt %}
          <p class="excerpt">{{ item.excerpt }}</p>
        {% endif %}
      </article>
    {% endfor %}
  {% endif %}
  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
