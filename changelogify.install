<?php

/**
 * @file
 * Install and update hooks for Changelogify.
 */

declare(strict_types=1);

/**
 * Backfills the settings introduced in Changelogify 1.2.
 */
function changelogify_update_12001(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');

  if ($config->get('track_content') === NULL) {
    $config->set('track_content', TRUE);
  }
  if ($config->get('track_modules') === NULL) {
    $config->set('track_modules', FALSE);
  }
  if ($config->get('track_users') === NULL) {
    $config->set('track_users', FALSE);
  }
  if ($config->get('event_retention_days') === NULL) {
    $config->set('event_retention_days', 0);
  }

  $config->save();

  \Drupal::logger('changelogify')->notice('Applied the Changelogify 1.2 configuration defaults. Existing values were preserved.');

  return 'Backfilled Changelogify 1.2 settings defaults.';
}

/**
 * Adds privacy and configurable-path defaults introduced in 1.3.
 */
function changelogify_update_13001(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');

  if ($config->get('track_unpublished_content') === NULL) {
    $config->set('track_unpublished_content', FALSE);
  }
  if ($config->get('changelog_path') === NULL) {
    $config->set('changelog_path', '/changelog');
  }

  $config->save();

  \Drupal::logger('changelogify')->notice('Applied the Changelogify 1.3 privacy and public path defaults. Existing values were preserved.');

  return 'Added Changelogify privacy and public path defaults.';
}

/**
 * Preserves the historical content capture policy for existing sites.
 */
function changelogify_update_14001(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');
  if ($config->get('content_capture') === NULL) {
    $entityTypes = [];
    foreach (['node'] as $entityTypeId) {
      $entityTypes[$entityTypeId] = [
        'enabled' => TRUE,
        'default_bundle_enabled' => TRUE,
        'bundles' => [],
      ];
    }
    $config->set('content_capture.entity_types', $entityTypes)->save();
  }

  \Drupal::logger('changelogify')->notice('Preserved the existing content capture policy; newly discovered entity types remain disabled.');
  return 'Added privacy-first content entity type and bundle policies.';
}

/**
 * Adds privacy defaults for configuration import capture.
 */
function changelogify_update_14002(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');
  if ($config->get('config_import.include_sensitive') === NULL) {
    $config->set('config_import.include_sensitive', FALSE);
  }
  if ($config->get('config_import.excluded_patterns') === NULL) {
    $config->set('config_import.excluded_patterns', []);
  }
  $config->save();
  return 'Added privacy defaults for correlated configuration import events.';
}

/**
 * Adds an independent retention policy for minimal release provenance.
 */
function changelogify_update_14003(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');
  if ($config->get('provenance_retention_days') === NULL) {
    $config->set('provenance_retention_days', 0)->save();
  }
  return 'Added the minimal release provenance retention policy.';
}

/**
 * Adds the source-language fallback default for existing sites.
 */
function changelogify_update_17001(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');
  if ($config->get('translation_fallback') === NULL) {
    $config->set('translation_fallback', 'fallback')->save();
  }
  return 'Enabled source-language fallback for existing releases.';
}

/**
 * Preserves existing capture behavior while adding safe automatic discovery.
 */
function changelogify_update_17002(): string {
  $config = \Drupal::configFactory()->getEditable('changelogify.settings');
  if ($config->get('auto_track_new_safe_content') === NULL) {
    $config->set('auto_track_new_safe_content', FALSE)->save();
  }
  return 'Added opt-in automatic tracking for newly discovered privacy-safe content.';
}
