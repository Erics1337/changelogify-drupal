{
    "name": "drupal/changelogify",
    "type": "drupal-module",
    "description": "Automatically collect site changes, group them into releases, and publish a public changelog.",
    "keywords": [
        "Drupal",
        "Changelog",
        "Release Notes"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/changelogify",
    "authors": [
        {
            "name": "Eric Swanson",
            "homepage": "https://github.com/Erics1337"
        }
    ],
    "support": {
        "issues": "https://github.com/Erics1337/changelogify-drupal/issues",
        "source": "https://github.com/Erics1337/changelogify-drupal"
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10.3 || ^11"
    },
    "require-dev": {
        "drush/drush": "^13"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
